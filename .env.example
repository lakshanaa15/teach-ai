# TeachAI Environment Configuration

# -----------------------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL / Prisma)
# -----------------------------------------------------------------------------
# Connection pooled connection string (used by Prisma, Transaction Pooler on port 6543):
DATABASE_URL="your_transaction_pooler_connection_string"

# Direct connection string for migrations (Direct connection on port 5432):
DIRECT_URL="your_direct_connection_string"

# -----------------------------------------------------------------------------
# Authentication & Institution Security Configuration
# -----------------------------------------------------------------------------
# Secret used for signing HMAC-SHA256 session JWTs in HTTP-only cookies:
SESSION_SECRET="teachai-secure-cryptographic-jwt-session-secret-2026"

# Server-side verification code required for Educator / Teacher registration:
TEACHER_REGISTRATION_CODE="MKCE-TEACH-2026"

# Default Demo Institution Code (validated for both Students and Teachers):
INSTITUTION_CODE="MKCE2026"

# -----------------------------------------------------------------------------
# AI Provider Configuration
# -----------------------------------------------------------------------------
# Active AI provider: "gemini" | "openai" | "mock"
AI_PROVIDER="gemini"

# Google Gemini API Key (Recommended):
GEMINI_API_KEY="your-gemini-api-key-here"

# Alternative: OpenAI API Key:
OPENAI_API_KEY="your-openai-api-key-here"

# -----------------------------------------------------------------------------
# File Storage Configuration
# -----------------------------------------------------------------------------
# Storage provider: "local" | "s3" | "vercel-blob"
STORAGE_PROVIDER="local"
UPLOAD_MAX_SIZE_MB=50

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
